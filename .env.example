# ==============================================================================
# PROJECT EZRA (JARVIS) CONFIGURATION
# ==============================================================================

# LLM Providers (Free on Google AI Studio & Groq)
# Multi-key rotation supported! Enter one or multiple keys separated by comma:
# GEMINI_API_KEY=key1,key2,key3
# Get free keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Recommended: Groq free tier gives 14,400 calls/day (~250ms ultra-fast voice responses, no card needed):
# Get free key at: https://console.groq.com
GROQ_API_KEY=

# Local Offline LLM (100% Free & Offline via Ollama on localhost)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Voice Configuration
# High-quality neural female voices (100% Free via Edge-TTS):
# English options:
#   - en-US-AriaNeural (Warm, natural, clear American female)
#   - en-GB-SoniaNeural (Polite, articulate British female - classic JARVIS/FRIDAY vibe)
#   - en-US-JennyNeural (Friendly conversational)
# Arabic options (if you'd like multilingual support):
#   - ar-EG-SalmaNeural / ar-SA-ZariyahNeural
DEFAULT_VOICE=en-GB-SoniaNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz
# Set to True for cybernetic vocoder robot synth voice, False for silky neural voice
ROBOTIC_VOICE=False

# ==============================================================================
# MUSA TURN-TAKING & SILENCE ENDPOINTING SPECIFICATION
# ==============================================================================
# Pause before Ezra takes your turn: 1.6s default (after you've spoken for >1.2s)
# If Ezra keeps cutting you off when pausing to think, raise to 2.0 - 2.5
END_SIL=1.6
# Pause after short reply: 0.9s (if spoken for under 1.2s like "yes" or "okay")
SHORT_SIL=0.9
# Longest single turn: 60.0s hard cap continuous talking
MAX_UTT=60.0
# Shortest speech accepted: 0.35s (shorter treated as noise/cough/click and discarded)
MIN_SPEECH=0.35
# Pre-speech audio ring buffer: 0.40s (keeps consonant before voice onset)
PRE_BUFFER_SEC=0.40
# Answer only when I say "Ezra" (False = open-mic mode, True = wake-word strictly required)
ANSWER_ONLY_ON_WAKE=False
# Push to talk (hold space bar or key: turn ends the moment you release, no silence timers)
PUSH_TO_TALK=False

# App / Media Defaults
DEFAULT_BROWSER=google-chrome
DEFAULT_MEDIA_PLAYER=vlc

# Telegram Bot (Optional: 100% Free for mobile remote control)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (Optional: Gmail App Password for sending emails)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Local Server
HOST=127.0.0.1
PORT=8080
DEBUG=True
